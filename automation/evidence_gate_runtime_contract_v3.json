{
  "contract_id": "RADAR_V3_EVIDENCE_GATE_RUNTIME_CONTRACT",
  "contract_version": "3.4D.3D.2",
  "status": "DRAFT",
  "scope": "V3_ONLY",

  "purpose": {
    "defines_runtime_interface": true,
    "implements_evidence_gate_engine": false,
    "defines_evidence_admissibility_policy": false,
    "defines_conflict_resolution": false,
    "defines_decision_state": false,
    "defines_actionable_authority": false,
    "writes_decision_center": false,
    "modifies_public_output": false
  },

  "compatibility": {
    "preserve_v2_1": true,
    "modify_v2_1": false,
    "modify_schema_v3": false,
    "modify_generator": false,
    "modify_existing_decision_center_contract": false,
    "requires_public_output_change": false
  },

  "upstream_policy": {
    "policy_id": "RADAR_V3_EVIDENCE_GATE_POLICY",
    "policy_version": "3.4D.3B",
    "consume_policy_without_redefinition": true
  },

  "runtime_functions": {
    "evaluate_asset_evidence": {
      "responsibility": "CLASSIFY_EVIDENCE_FOR_ONE_ASSET",
      "inputs": [
        "asset",
        "evidence_gate_policy",
        "publication_context",
        "risk_source_context"
      ],
      "required_inputs": [
        "asset",
        "evidence_gate_policy"
      ],
      "optional_inputs": [
        "publication_context",
        "risk_source_context"
      ],
      "returns": "evidence_gate_result",
      "may_mutate_asset": false,
      "may_write_decision_center": false,
      "may_select_decision_state": false,
      "may_establish_actionable_authority": false
    },

    "apply_evidence_gate": {
      "responsibility": "CLASSIFY_EVIDENCE_FOR_RADAR_ASSETS",
      "inputs": [
        "radar",
        "evidence_gate_policy",
        "publication_context_by_ticker",
        "risk_source_context_by_ticker"
      ],
      "required_inputs": [
        "radar",
        "evidence_gate_policy"
      ],
      "optional_inputs": [
        "publication_context_by_ticker",
        "risk_source_context_by_ticker"
      ],
      "returns": "evidence_gate_context_by_ticker",
      "may_mutate_radar": false,
      "may_write_decision_center": false,
      "may_select_decision_state": false,
      "may_establish_actionable_authority": false
    }
  },

  "runtime_input_ownership": {
    "asset": "UPSTREAM_PERSISTED_INPUT",
    "radar": "UPSTREAM_PERSISTED_INPUT",
    "evidence_gate_policy": "D3_POLICY_INPUT",
    "publication_context": "OPTIONAL_RUNTIME_CONTEXT",
    "publication_context_by_ticker": "OPTIONAL_RUNTIME_SIDECAR",
    "risk_source_context": "OPTIONAL_RUNTIME_CONTEXT",
    "risk_source_context_by_ticker": "OPTIONAL_RUNTIME_SIDECAR"
  },

  "authorized_upstream_domains": [
    "RADAR_SCORE",
    "COVERAGE",
    "CONFIDENCE",
    "PUBLICATION_ELIGIBILITY",
    "RISK",
    "DOMAIN_SIGNALS",
    "CATALYSTS",
    "INSTITUTIONAL_FLOW",
    "PORTFOLIO",
    "MARKET_REGIME"
  ],

  "upstream_consumption": {
    "score": {
      "consume": true,
      "recalculate": false
    },
    "coverage": {
      "consume": true,
      "recalculate": false
    },
    "confidence": {
      "consume": true,
      "recalculate": false
    },
    "publication_eligibility": {
      "consume": true,
      "recalculate": false,
      "override": false
    },
    "risk": {
      "consume": true,
      "recalculate": false
    },
    "domain_signals": {
      "consume": true,
      "recalculate": false
    },
    "provenance": {
      "consume": true,
      "recalculate": false,
      "invent": false,
      "repair": false
    },
    "catalysts": {
      "consume": true,
      "recalculate": false
    },
    "institutional_flow": {
      "consume": true,
      "recalculate": false
    },
    "portfolio": {
      "consume": true,
      "recalculate": false
    },
    "market_regime": {
      "consume": true,
      "recalculate": false
    }
  },

  "threshold_governance": {
    "defines_new_numeric_thresholds": false,
    "duplicates_upstream_numeric_thresholds": false,
    "redefines_score_thresholds": false,
    "redefines_confidence_thresholds": false,
    "redefines_signal_thresholds": false,
    "redefines_risk_thresholds": false,
    "redefines_publication_source_tiers": false
  },

  "result_contract": {
    "storage_mode": "TRANSIENT_SIDECAR",
    "persist_in_asset": false,
    "persist_in_radar_root": false,
    "write_decision_center": false,

    "per_ticker_required_fields": [
      "ticker",
      "gate_status",
      "evidence_gate_passed",
      "admissible_evidence",
      "restricted_evidence",
      "blocked_evidence",
      "insufficient_evidence",
      "unknown_evidence",
      "reasons"
    ],

    "gate_status_allowed_values": [
      "PASSED",
      "RESTRICTED",
      "BLOCKED",
      "INSUFFICIENT",
      "UNKNOWN"
    ],

    "evidence_gate_passed_semantics": {
      "PASSED": true,
      "RESTRICTED": false,
      "BLOCKED": false,
      "INSUFFICIENT": false,
      "UNKNOWN": false
    },

    "evidence_buckets": {
      "admissible_evidence": "ADMISSIBLE",
      "restricted_evidence": "RESTRICTED",
      "blocked_evidence": "BLOCKED",
      "insufficient_evidence": "INSUFFICIENT",
      "unknown_evidence": "UNKNOWN"
    }
  },

  "evidence_item_contract": {
    "required_fields": [
      "evidence_id",
      "domain",
      "information_class",
      "gate_result",
      "reason_code"
    ],

    "optional_fields": [
      "source_reference",
      "upstream_status",
      "publication_status",
      "provenance_status",
      "coverage_status",
      "details"
    ],

    "information_class_allowed_values": [
      "FACT",
      "MODEL",
      "INFERENCE"
    ],

    "gate_result_allowed_values": [
      "ADMISSIBLE",
      "RESTRICTED",
      "BLOCKED",
      "INSUFFICIENT",
      "UNKNOWN"
    ],

    "decision_is_evidence": false,
    "reason_code_required": true,
    "domain_required": true,
    "information_class_required": true
  },

  "reason_contract": {
    "required_fields": [
      "reason_code",
      "domain",
      "information_class",
      "gate_result"
    ],
    "must_be_traceable": true,
    "blocked_reason_must_be_preserved": true,
    "insufficient_reason_must_be_preserved": true,
    "unknown_reason_must_be_preserved": true
  },

  "missing_semantics": {
    "missing_is_neutral": false,
    "missing_is_negative": false,
    "missing_is_positive": false,
    "missing_is_zero": false,
    "missing_is_admissible": false,
    "missing_required_evidence_result": "INSUFFICIENT"
  },

  "publication_boundary": {
    "consume_upstream_publication_eligibility": true,
    "may_override_publication_eligibility": false,
    "may_promote_publication_ineligible_evidence": false,
    "publication_ineligible_where_required_result": "BLOCKED"
  },

  "provenance_boundary": {
    "consume_upstream_provenance": true,
    "may_invent_provenance": false,
    "may_repair_invalid_provenance": false,
    "invalid_required_provenance_result": "BLOCKED",
    "unknown_required_provenance_result": "UNKNOWN"
  },

  "conflict_boundary": {
    "preserve_multiple_evidence_items": true,
    "preserve_conflicting_admissible_evidence": true,
    "detect_semantic_conflict": false,
    "resolve_conflict": false,
    "conflict_resolver_phase": "D.4"
  },

  "decision_boundary": {
    "gate_result_is_decision_state": false,
    "gate_status_is_decision_state": false,
    "evidence_gate_passed_is_actionable_authority": false,
    "admissible_evidence_is_actionable_authority": false,
    "may_select_ACTIONABLE": false,
    "may_select_WATCH": false,
    "may_select_WAIT_FOR_CONFIRMATION": false,
    "may_select_RISK_REVIEW": false,
    "may_select_THESIS_REVIEW": false,
    "may_select_INSUFFICIENT_EVIDENCE": false,
    "decision_state_phase": "D.5",
    "actionable_authority_policy": "RADAR_V3_ACTIONABLE_AUTHORITY_POLICY"
  },

  "mutation_boundary": {
    "mutate_asset": false,
    "mutate_radar": false,
    "write_asset_evidence_gate_field": false,
    "write_radar_evidence_gate_field": false,
    "write_decision_center": false,
    "modify_schema_v3": false,
    "modify_generator": false,
    "modify_v2_1": false
  },

  "phase_boundaries": {
    "D3D2_defines_runtime_contract": true,
    "D3D2_implements_engine": false,
    "evidence_gate_engine_phase": "D.3",
    "conflict_resolver_phase": "D.4",
    "decision_state_engine_phase": "D.5",
    "traceability_phase": "D.6",
    "generator_integration_phase": "D.7"
  },

  "prohibited_behaviors": [
    "MODIFY_V2_1",
    "MODIFY_SCHEMA_V3_IN_D3D2",
    "MODIFY_GENERATOR_IN_D3D2",
    "WRITE_DECISION_CENTER_IN_D3D2",
    "MUTATE_ASSET_IN_EVIDENCE_GATE",
    "MUTATE_RADAR_IN_EVIDENCE_GATE",
    "PERSIST_EVIDENCE_GATE_IN_ASSET",
    "PERSIST_EVIDENCE_GATE_IN_RADAR_ROOT",
    "RECALCULATE_SCORE",
    "RECALCULATE_COVERAGE",
    "RECALCULATE_CONFIDENCE",
    "RECALCULATE_RISK",
    "RECALCULATE_SIGNALS",
    "RECALCULATE_PUBLICATION_ELIGIBILITY",
    "RECALCULATE_PROVENANCE",
    "INVENT_PROVENANCE",
    "REPAIR_INVALID_PROVENANCE",
    "REDEFINE_UPSTREAM_NUMERIC_THRESHOLDS",
    "REDEFINE_PUBLICATION_SOURCE_TIERS",
    "OVERRIDE_PUBLICATION_ELIGIBILITY",
    "PROMOTE_PUBLICATION_INELIGIBLE_EVIDENCE",
    "TREAT_MISSING_AS_NEUTRAL",
    "TREAT_MISSING_AS_ZERO",
    "TREAT_MISSING_AS_ADMISSIBLE",
    "DISCARD_BLOCKED_EVIDENCE",
    "DISCARD_INSUFFICIENT_EVIDENCE",
    "DISCARD_UNKNOWN_EVIDENCE",
    "RESOLVE_CONFLICTS_IN_D3",
    "SELECT_DECISION_STATE_IN_D3",
    "CREATE_ACTIONABLE_AUTHORITY_FROM_GATE_PASS",
    "CREATE_ACTIONABLE_AUTHORITY_FROM_ADMISSIBLE_EVIDENCE",
    "TRANSLATE_GATE_PASS_TO_BUY",
    "TRANSLATE_GATE_PASS_TO_SELL",
    "EXECUTE_TRADE_FROM_EVIDENCE_GATE"
  ]
}
