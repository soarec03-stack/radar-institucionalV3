{
  "policy_id": "RADAR_INSTITUCIONAL_V3_SHORT_INTEREST_CORPORATE_ACTION_INTEGRATION",
  "version": "3.4D.2-B.2C.7C.1",
  "status": "ACTIVE",

  "purpose": {
    "objective": "Define the contract between Positive Official Window Review and Short Interest Corporate Action Reconciliation.",
    "scope": "Short Interest corporate action integration only.",
    "responsibility": "Validate and transport evidence between review and reconciliation layers without independently authorizing final Short Interest analytical usability.",
    "out_of_scope": [
      "NETWORK_COLLECTION",
      "SEC_COLLECTION",
      "FINRA_COLLECTION",
      "SIGNAL_GENERATION",
      "CONFIDENCE_SCORING",
      "RADAR_SCORE",
      "DECISION_GENERATION",
      "PORTFOLIO_DECISION",
      "RADAR_PUBLICATION"
    ]
  },

  "architecture": {
    "upstream_component": "POSITIVE_OFFICIAL_WINDOW_REVIEW",
    "integration_component": "CORPORATE_ACTION_INTEGRATION_ADAPTER",
    "downstream_component": "CORPORATE_ACTION_RECONCILER",

    "flow": [
      "POSITIVE_OFFICIAL_WINDOW_REVIEW",
      "CORPORATE_ACTION_INTEGRATION_ADAPTER",
      "CORPORATE_ACTION_RECONCILER"
    ],

    "adapter_role": [
      "VALIDATE_UPSTREAM_CONTRACT",
      "VALIDATE_IDENTITY_CONTINUITY",
      "VALIDATE_SETTLEMENT_WINDOW",
      "VALIDATE_REVIEW_STATUS",
      "VALIDATE_ACTION_EVIDENCE_WHEN_REQUIRED",
      "VALIDATE_SOURCE_ADJUSTMENT_EVIDENCE_WHEN_PRESENT",
      "PRESERVE_RAW_EVIDENCE",
      "MAP_TO_RECONCILER_INPUT",
      "BLOCK_INCOMPLETE_OR_CONFLICTING_INPUT"
    ]
  },

  "principles": {
    "fail_closed": true,
    "adapter_must_not_invent_evidence": true,
    "adapter_must_not_infer_action_parameters": true,
    "adapter_must_not_infer_source_adjustment": true,
    "adapter_must_not_override_authoritative_conflict": true,
    "adapter_must_preserve_raw_evidence": true,
    "adapter_must_preserve_identity": true,
    "adapter_must_preserve_settlement_window": true,
    "ticker_only_identity_prohibited": true,
    "missing_is_not_zero": true,
    "missing_is_not_neutral": true,
    "review_analytically_usable_is_not_final_short_interest_usable": true,
    "final_analytical_usability_belongs_to_reconciler": true,
    "no_direct_write_to_radar": true
  },

  "accepted_upstream_versions": {
    "positive_official_window_review_policy": [
      "3.4D.2-B.2C.7A"
    ],
    "positive_official_window_review_engine": [
      "3.4D.2-B.2C.7B"
    ],
    "corporate_action_reconciliation_policy": [
      "3.4D.2-B.2C.1"
    ],
    "corporate_action_reconciler": [
      "3.4D.2-B.2C.5"
    ]
  },

  "identity_contract": {
    "required": true,
    "required_fields": [
      "ticker",
      "listing_exchange",
      "security_identity"
    ],
    "recommended_fields": [
      "cusip",
      "sec_cik"
    ],
    "ticker_only_prohibited": true,
    "required_continuity_status": "VERIFIED",
    "identity_mismatch_result": "BLOCKED"
  },

  "settlement_window_contract": {
    "required": true,
    "basis": "SETTLEMENT_DATE",
    "required_fields": [
      "previous_settlement_date",
      "current_settlement_date"
    ],
    "previous_boundary": "EXCLUSIVE",
    "current_boundary": "INCLUSIVE",
    "current_must_be_after_previous": true,
    "adapter_must_not_change_window": true,
    "review_and_reconciliation_windows_must_match": true,
    "window_mismatch_result": "BLOCKED"
  },

  "review_status_contract": {
    "allowed_statuses": [
      "NO_ACTION_PROVEN",
      "ACTION_FOUND",
      "UNRESOLVED"
    ],

    "NO_ACTION_PROVEN": {
      "required_upstream": {
        "corporate_action_status": "NO_ACTION",
        "reconciliation_eligible": true,
        "official_window_review_completed": true,
        "authoritative_source_review_present": true,
        "economic_window_reviewed": true,
        "identity_continuity_verified": true,
        "no_qualified_action_in_economic_window": true,
        "no_unresolved_action_candidate_affecting_window": true,
        "no_authoritative_evidence_conflict": true,
        "minimum_authoritative_reviews_satisfied": true
      },

      "adapter_output": {
        "integration_status": "READY_FOR_RECONCILIATION",
        "route": "NO_ACTION",
        "reconciler_input_status": "NO_ACTION_PROVEN"
      },

      "action_evidence_required": false,
      "adapter_may_mark_final_short_interest_usable": false
    },

    "ACTION_FOUND": {
      "required_upstream": {
        "corporate_action_status": "VERIFIED_ACTION",
        "reconciliation_eligible": true,
        "official_window_review_completed": true,
        "authoritative_source_review_present": true,
        "economic_window_reviewed": true,
        "identity_continuity_verified": true,
        "no_qualified_action_in_economic_window": false,
        "no_unresolved_action_candidate_affecting_window": true,
        "no_authoritative_evidence_conflict": true
      },

      "adapter_output_when_complete": {
        "integration_status": "READY_FOR_RECONCILIATION",
        "route": "VERIFIED_ACTION",
        "reconciler_input_status": "VERIFIED_ACTION"
      },

      "adapter_output_when_incomplete": {
        "integration_status": "BLOCKED",
        "route": "NONE",
        "reconciler_input_status": "UNRESOLVED"
      },

      "action_evidence_required": true,
      "adapter_may_mark_final_short_interest_usable": false
    },

    "UNRESOLVED": {
      "adapter_output": {
        "integration_status": "BLOCKED",
        "route": "NONE",
        "reconciler_input_status": "UNRESOLVED"
      },

      "may_enter_reconciler": false,
      "adapter_may_mark_final_short_interest_usable": false
    }
  },

  "action_evidence_contract": {
    "required_for_review_status": "ACTION_FOUND",

    "required_fields": [
      "action_type",
      "effective_date",
      "source_id",
      "source_type",
      "source_tier",
      "identity_status",
      "evidence_status"
    ],

    "allowed_action_types": [
      "STOCK_SPLIT",
      "REVERSE_STOCK_SPLIT",
      "SHARE_RECLASSIFICATION",
      "SECURITY_IDENTITY_CHANGE",
      "CUSIP_CHANGE",
      "OTHER_SHARE_BASIS_CHANGE"
    ],

    "required_source_tier": "TIER_1",
    "required_identity_status": "VERIFIED",
    "required_evidence_status": "VERIFIED",

    "effective_date": {
      "must_be_in_economic_window": true,
      "previous_boundary": "EXCLUSIVE",
      "current_boundary": "INCLUSIVE"
    },

    "ratio_required_for": [
      "STOCK_SPLIT",
      "REVERSE_STOCK_SPLIT"
    ],

    "ratio_fields": [
      "ratio_numerator",
      "ratio_denominator"
    ],

    "ratio_rules": {
      "numerator_must_be_positive": true,
      "denominator_must_be_positive": true,
      "zero_prohibited": true,
      "negative_prohibited": true,
      "adapter_must_not_infer_missing_ratio": true
    },

    "incomplete_action_evidence_result": "BLOCKED"
  },

  "source_adjustment_contract": {
    "purpose": "Prevent double adjustment when the authoritative Short Interest source has already normalized historical quantities.",

    "allowed_statuses": [
      "NOT_ADJUSTED",
      "SOURCE_ALREADY_ADJUSTED",
      "UNRESOLVED"
    ],

    "SOURCE_ALREADY_ADJUSTED": {
      "requires_positive_official_statement": true,
      "required_source_tier": "TIER_1",

      "required_fields": [
        "source_id",
        "source_type",
        "source_tier",
        "statement",
        "scope",
        "evidence_status"
      ],

      "required_evidence_status": "VERIFIED",
      "adapter_must_not_infer_from_numbers": true,
      "adapter_must_not_infer_from_continuity": true,
      "adapter_must_not_apply_second_adjustment": true
    },

    "UNRESOLVED": {
      "integration_status": "BLOCKED"
    }
  },

  "conflict_contract": {
    "authoritative_conflict_blocks": true,
    "identity_conflict_blocks": true,
    "window_conflict_blocks": true,
    "action_parameter_conflict_blocks": true,
    "source_adjustment_conflict_blocks": true,
    "tier_2_cannot_override_tier_1": true,
    "conflict_result": "BLOCKED"
  },

  "mapping_contract": {
    "NO_ACTION_PROVEN": {
      "reconciler_fields": {
        "corporate_action_status": "NO_ACTION",
        "reconciliation_status": "NO_ACTION",
        "adjustment_status": "NOT_REQUIRED",
        "adjustment_authorized": false
      }
    },

    "VERIFIED_ACTION_ADJUSTMENT_REQUIRED": {
      "reconciler_fields": {
        "corporate_action_status": "VERIFIED_ACTION",
        "reconciliation_status": "VERIFIED_ACTION",
        "adjustment_status": "REQUIRED",
        "adjustment_authorized": true
      }
    },

    "VERIFIED_ACTION_SOURCE_ALREADY_ADJUSTED": {
      "reconciler_fields": {
        "corporate_action_status": "VERIFIED_ACTION",
        "reconciliation_status": "SOURCE_ADJUSTED",
        "adjustment_status": "SOURCE_ALREADY_ADJUSTED",
        "adjustment_authorized": false
      }
    },

    "BLOCKED": {
      "reconciler_fields": {
        "corporate_action_status": "UNRESOLVED",
        "reconciliation_status": "UNRESOLVED",
        "adjustment_status": "BLOCKED",
        "adjustment_authorized": false
      }
    }
  },

  "analytical_usability_contract": {
    "upstream_review_analytically_usable_is_advisory_only": true,
    "adapter_cannot_set_final_short_interest_analytically_usable_true": true,
    "adapter_blocked_must_be_unusable": true,
    "final_authority": "CORPORATE_ACTION_RECONCILER",

    "required_sequence": [
      "REVIEW",
      "ADAPTER",
      "RECONCILER",
      "FINAL_SHORT_INTEREST_COMPARABILITY"
    ]
  },

  "output_contract": {
    "required_fields": [
      "ticker",
      "previous_settlement_date",
      "current_settlement_date",
      "identity",
      "review_status",
      "integration_status",
      "route",
      "reconciler_input_status",
      "action_evidence",
      "source_adjustment",
      "raw_review",
      "diagnostics"
    ],

    "integration_statuses": [
      "READY_FOR_RECONCILIATION",
      "BLOCKED"
    ],

    "routes": [
      "NO_ACTION",
      "VERIFIED_ACTION",
      "NONE"
    ],

    "raw_review_must_be_preserved": true,
    "diagnostics_required": true
  },

  "downstream_permissions": {
    "READY_FOR_RECONCILIATION": {
      "may_enter_reconciler": true,
      "may_write_final_short_interest_metric": false,
      "may_write_signal": false,
      "may_write_confidence": false,
      "may_write_radar_score": false,
      "may_write_decision": false
    },

    "BLOCKED": {
      "may_enter_reconciler": false,
      "may_write_final_short_interest_metric": false,
      "may_write_signal": false,
      "may_write_confidence": false,
      "may_write_radar_score": false,
      "may_write_decision": false
    }
  },

  "required_controlled_scenarios": [
    "NO_ACTION_PROVEN_READY",
    "ACTION_FOUND_COMPLETE_SPLIT_READY",
    "ACTION_FOUND_INCOMPLETE_BLOCKED",
    "UNRESOLVED_BLOCKED",
    "IDENTITY_MISMATCH_BLOCKED",
    "SETTLEMENT_WINDOW_MISMATCH_BLOCKED",
    "AUTHORITATIVE_CONFLICT_BLOCKED",
    "SOURCE_ALREADY_ADJUSTED_READY"
  ],

  "prohibited_behaviors": [
    "COPY_REVIEW_ANALYTICALLY_USABLE_TO_FINAL_SHORT_INTEREST",
    "INVENT_ACTION_TYPE",
    "INVENT_EFFECTIVE_DATE",
    "INVENT_SPLIT_RATIO",
    "INFER_SOURCE_ADJUSTMENT_FROM_NUMBERS",
    "INFER_SOURCE_ADJUSTMENT_FROM_SHORT_INTEREST_CONTINUITY",
    "IGNORE_IDENTITY_MISMATCH",
    "IGNORE_SETTLEMENT_WINDOW_MISMATCH",
    "IGNORE_AUTHORITATIVE_CONFLICT",
    "ALLOW_TIER_2_TO_OVERRIDE_TIER_1",
    "DOUBLE_ADJUST_SOURCE_ADJUSTED_DATA",
    "ROUTE_UNRESOLVED_TO_RECONCILER",
    "WRITE_DIRECTLY_TO_RADAR_JSON",
    "WRITE_DIRECTLY_TO_SIGNAL",
    "WRITE_DIRECTLY_TO_CONFIDENCE",
    "WRITE_DIRECTLY_TO_RADAR_SCORE",
    "WRITE_DIRECTLY_TO_DECISION_CENTER"
  ]
}