{
  "policy_id": "RADAR_INSTITUCIONAL_V3_SHORT_INTEREST_REAL_RECONCILIATION_PIPELINE",
  "version": "3.4D.2-B.2C.8A",
  "status": "ACTIVE",
  "purpose": "Define the fail-closed production contract for connecting real Short Interest collection and real Corporate Action evidence to the Positive Official Window Review, Integration Adapter, Corporate Action Reconciler, Reconciled Short Interest Fact, and downstream Quality Gate.",
  "scope": {
    "domain": "SHORT_INTEREST",
    "mode": "REAL_CONTROLLED_EXECUTION",
    "network_collection_owned_by_pipeline": false,
    "mutates_radar_v3": false,
    "calculates_signal": false,
    "calculates_confidence": false,
    "calculates_radar_score": false,
    "generates_decision": false,
    "publishes_asset": false
  },
  "principles": {
    "fail_closed": true,
    "absence_of_evidence_is_not_no_action": true,
    "zero_sec_matches_is_not_no_action": true,
    "resolver_status_resolved_is_not_no_action": true,
    "missing_is_not_zero": true,
    "missing_is_not_neutral": true,
    "real_inputs_must_be_preserved": true,
    "raw_short_interest_must_be_preserved": true,
    "raw_corporate_action_evidence_must_be_preserved": true,
    "identity_continuity_required": true,
    "settlement_window_consistency_required": true,
    "positive_official_review_required_for_no_action": true,
    "authoritative_action_evidence_required_for_adjustment": true,
    "double_adjustment_prohibited": true,
    "adapter_ready_is_not_final_usability": true,
    "reconciler_owns_final_comparability": true,
    "quality_gate_required_before_downstream_use": true
  },
  "accepted_component_versions": {
    "positive_official_window_review_policy": [
      "3.4D.2-B.2C.7A"
    ],
    "positive_official_window_review_engine": [
      "3.4D.2-B.2C.7B"
    ],
    "integration_policy": [
      "3.4D.2-B.2C.7C.1"
    ],
    "integration_adapter": [
      "3.4D.2-B.2C.7C.2"
    ],
    "corporate_action_reconciliation_policy": [
      "3.4D.2-B.2C.1"
    ],
    "corporate_action_reconciler": [
      "3.4D.2-B.2C.5"
    ]
  },
  "real_inputs": {
    "short_interest_collection": {
      "path": "input/short_interest_collection_v3.json",
      "required": true,
      "source": "SHORT_INTEREST_COLLECTOR",
      "real_data": true,
      "read_only": true
    },
    "corporate_action_evidence": {
      "path": "input/short_interest_corporate_action_evidence_v3.json",
      "required": true,
      "source": "SEC_CORPORATE_ACTION_EVIDENCE_RESOLVER",
      "real_data": true,
      "read_only": true
    }
  },
  "join_contract": {
    "join_key": [
      "ticker"
    ],
    "required_identity_fields": [
      "ticker",
      "listing_exchange",
      "security_identity"
    ],
    "ticker_only_identity_is_sufficient": false,
    "require_identity_continuity": true,
    "require_exact_settlement_window_match": true,
    "previous_settlement_boundary": "EXCLUSIVE",
    "current_settlement_boundary": "INCLUSIVE",
    "current_must_be_after_previous": true,
    "missing_asset_on_either_side": "BLOCK",
    "duplicate_asset_on_either_side": "BLOCK",
    "identity_mismatch": "BLOCK",
    "settlement_window_mismatch": "BLOCK"
  },
  "pipeline_stages": [
    {
      "order": 1,
      "stage": "LOAD_REAL_INPUTS",
      "owner": "REAL_PIPELINE",
      "fail_closed": true
    },
    {
      "order": 2,
      "stage": "VALIDATE_JOIN_AND_IDENTITY",
      "owner": "REAL_PIPELINE",
      "fail_closed": true
    },
    {
      "order": 3,
      "stage": "POSITIVE_OFFICIAL_WINDOW_REVIEW",
      "owner": "B.2C.7B",
      "fail_closed": true
    },
    {
      "order": 4,
      "stage": "INTEGRATION_ADAPTER",
      "owner": "B.2C.7C.2",
      "fail_closed": true
    },
    {
      "order": 5,
      "stage": "CORPORATE_ACTION_RECONCILER",
      "owner": "B.2C.5",
      "fail_closed": true
    },
    {
      "order": 6,
      "stage": "BUILD_RECONCILED_SHORT_INTEREST_FACT",
      "owner": "REAL_PIPELINE",
      "fail_closed": true
    },
    {
      "order": 7,
      "stage": "QUALITY_GATE",
      "owner": "SHORT_INTEREST_QUALITY_GATE",
      "fail_closed": true
    }
  ],
  "review_contract": {
    "no_action_requires_positive_official_review": true,
    "zero_raw_matches_sufficient_for_no_action": false,
    "zero_qualified_actions_sufficient_for_no_action": false,
    "resolver_resolved_sufficient_for_no_action": false,
    "authoritative_review_minimum_tier": "TIER_1",
    "unresolved_review_result": "BLOCK"
  },
  "adapter_contract": {
    "blocked_result_must_not_enter_reconciler": true,
    "ready_for_reconciliation_is_final_usability": false,
    "adapter_may_translate_contract_fields": true,
    "adapter_may_invent_evidence": false,
    "adapter_may_invent_action_parameters": false,
    "adapter_may_invent_source_adjustment": false
  },
  "reconciler_contract": {
    "owns_final_corporate_action_comparability": true,
    "verified_action_required_for_adjustment": true,
    "preserve_previous_raw": true,
    "preserve_current_raw": true,
    "current_raw_must_not_be_adjusted": true,
    "target_basis": "CURRENT_SETTLEMENT_BASIS",
    "source_already_adjusted_must_not_be_adjusted_again": true
  },
  "reconciled_fact_contract": {
    "required_fields": [
      "ticker",
      "previous_settlement_date",
      "current_settlement_date",
      "previous_short_interest_raw",
      "current_short_interest_raw",
      "corporate_action_status",
      "reconciliation_status",
      "adjustment_status",
      "adjustment_authorized",
      "analytically_usable",
      "quality_status",
      "diagnostics"
    ],
    "conditional_fields": {
      "when_adjustment_required": [
        "adjustment_factor",
        "previous_short_interest_adjusted",
        "adjusted_change_pct"
      ],
      "when_source_already_adjusted": [
        "source_adjustment_status"
      ]
    },
    "allowed_corporate_action_statuses": [
      "NO_ACTION",
      "VERIFIED_ACTION",
      "UNRESOLVED"
    ],
    "allowed_reconciliation_statuses": [
      "NO_ACTION",
      "VERIFIED_ACTION",
      "SOURCE_ADJUSTED",
      "UNRESOLVED"
    ],
    "allowed_adjustment_statuses": [
      "NOT_REQUIRED",
      "REQUIRED",
      "SOURCE_ALREADY_ADJUSTED",
      "BLOCKED"
    ],
    "allowed_quality_statuses": [
      "VERIFIED",
      "PARTIAL",
      "BLOCKED",
      "UNAVAILABLE"
    ]
  },
  "quality_gate_contract": {
    "required": true,
    "verified_requires_reconciler_usable": true,
    "blocked_reconciliation_must_not_be_verified": true,
    "unresolved_corporate_action_must_not_be_verified": true,
    "missing_required_fact_must_not_be_verified": true,
    "quality_gate_may_promote_to_downstream_usable": true,
    "pipeline_before_quality_gate_may_promote_to_downstream_usable": false
  },
  "real_execution_expectations": {
    "unresolved_is_valid_pipeline_outcome": true,
    "all_assets_unresolved_is_valid_pipeline_outcome": true,
    "real_execution_success_does_not_require_verified_assets": true,
    "real_execution_success_requires_structural_completion": true,
    "real_execution_success_requires_fail_closed_behavior": true
  },
  "output_contract": {
    "path": "input/short_interest_reconciled_v3.json",
    "write_mode": "ATOMIC_REPLACE",
    "must_preserve_input_files": true,
    "root_required_fields": [
      "pipeline_version",
      "generated_at",
      "source_collection_file",
      "source_evidence_file",
      "assets",
      "summary"
    ],
    "summary_required_fields": [
      "total_assets",
      "verified",
      "partial",
      "blocked",
      "unavailable",
      "analytically_usable"
    ]
  },
  "downstream_permissions": {
    "may_write_reconciled_short_interest_file": true,
    "may_update_short_interest_quality_layer": true,
    "may_write_radar_v3_directly": false,
    "may_write_signal_directly": false,
    "may_write_confidence_directly": false,
    "may_write_radar_score_directly": false,
    "may_write_decision_center_directly": false,
    "may_publish_directly": false
  },
  "prohibited_behaviors": [
    "DECLARE_NO_ACTION_FROM_ZERO_SEC_MATCHES",
    "DECLARE_NO_ACTION_FROM_ZERO_QUALIFIED_ACTIONS",
    "DECLARE_NO_ACTION_FROM_RESOLVER_STATUS_RESOLVED",
    "DECLARE_NO_ACTION_FROM_ABSENCE_OF_EVIDENCE",
    "DECLARE_NO_ACTION_FROM_PRICE_VOLUME_OR_SHORT_INTEREST_BEHAVIOR",
    "USE_TICKER_ONLY_AS_SECURITY_IDENTITY",
    "IGNORE_SETTLEMENT_WINDOW_MISMATCH",
    "CALL_RECONCILER_AFTER_ADAPTER_BLOCKED",
    "PROMOTE_ADAPTER_READY_TO_FINAL_USABILITY",
    "INVENT_CORPORATE_ACTION",
    "INVENT_ACTION_EFFECTIVE_DATE",
    "INVENT_SPLIT_RATIO",
    "INVENT_SOURCE_ADJUSTMENT",
    "DOUBLE_ADJUST_SHORT_INTEREST",
    "OVERWRITE_RAW_SHORT_INTEREST",
    "OVERWRITE_RAW_CORPORATE_ACTION_EVIDENCE",
    "WRITE_DIRECTLY_TO_RADAR_SCORE",
    "WRITE_DIRECTLY_TO_DECISION_CENTER",
    "PUBLISH_BEFORE_QUALITY_GATE"
  ],
  "required_controlled_scenarios": [
    "REAL_INPUTS_VALID_BUT_NO_POSITIVE_OFFICIAL_REVIEW",
    "REAL_INPUT_IDENTITY_MISMATCH",
    "REAL_INPUT_SETTLEMENT_WINDOW_MISMATCH",
    "NO_ACTION_PROVEN",
    "VERIFIED_ACTION_ADJUSTMENT_REQUIRED",
    "VERIFIED_ACTION_SOURCE_ALREADY_ADJUSTED",
    "ADAPTER_BLOCKED",
    "RECONCILER_UNRESOLVED",
    "QUALITY_GATE_BLOCKED",
    "ALL_REAL_ASSETS_UNRESOLVED"
  ]
}