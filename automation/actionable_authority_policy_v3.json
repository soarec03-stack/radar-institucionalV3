{
  "policy_id": "RADAR_V3_ACTIONABLE_AUTHORITY_POLICY",
  "policy_version": "3.4D.2D.4B",
  "status": "DRAFT",
  "scope": "RADAR_INSTITUCIONAL_V3_ONLY",

  "compatibility": {
    "preserves_v2_1": true,
    "schema_change_required": false,
    "public_output_change_required": false,
    "modifies_decision_policy_v3": false
  },

  "purpose": {
    "defines_positive_actionable_authority": true,
    "defines_trade_execution": false,
    "defines_buy_or_sell_instruction": false,
    "defines_portfolio_action": false,
    "recalculates_upstream_models": false
  },

  "authority_semantics": {
    "authority_token": "ACTIONABLE_AUTHORITY_EXPLICITLY_ESTABLISHED",
    "authority_is_positive": true,
    "authority_is_default": false,
    "authority_is_trade_instruction": false,
    "authority_is_buy": false,
    "authority_is_sell": false,
    "authority_is_guarantee": false,
    "authority_may_be_invented": false
  },

  "establishment_rule": {
    "mode": "EXPLICIT_EVIDENCE_CONVERGENCE",
    "all_conditions_required": true,
    "conditions": [
      "EVIDENCE_GATE_PASSED",
      "USABLE_AUTHORIZED_EVIDENCE_PRESENT",
      "EXPLICIT_DIRECTIONAL_THESIS_PRESENT",
      "DIRECTIONAL_THESIS_SUPPORTED_BY_AUTHORIZED_EVIDENCE",
      "NO_UNRESOLVED_MATERIAL_CONFLICT",
      "NO_MATERIAL_RISK_RESTRICTION",
      "NO_REQUIRED_CONFIRMATION_MISSING",
      "PUBLICATION_REQUIREMENTS_SATISFIED_WHERE_APPLICABLE"
    ],
    "failure_to_establish_authority": "NO_ACTIONABLE_AUTHORITY",
    "failure_does_not_mean_negative": true
  },

  "directional_thesis": {
    "required": true,
    "must_be_explicit": true,
    "must_be_traceable": true,
    "must_be_supported_by_authorized_evidence": true,
    "may_be_invented_from_score_label": false,
    "may_be_invented_from_normalized_score": false,
    "may_be_invented_from_risk_level": false,
    "may_be_invented_from_confidence_status": false,
    "may_be_invented_from_generic_market_intuition": false
  },

  "authorized_evidence_classes": [
    "FACT",
    "MODEL",
    "INFERENCE"
  ],

  "authorized_input_domains": [
    "RADAR_SCORE",
    "COVERAGE",
    "CONFIDENCE",
    "PUBLICATION_ELIGIBILITY",
    "RISK",
    "DOMAIN_SIGNALS",
    "CATALYSTS",
    "INSTITUTIONAL_FLOW",
    "PORTFOLIO",
    "MARKET_REGIME"
  ],

  "input_governance": {
    "inputs_are_consumed_not_recalculated": true,
    "blocked_evidence_may_support_authority": false,
    "unavailable_evidence_may_support_authority": false,
    "unknown_evidence_may_support_authority": false,
    "invalid_provenance_may_support_authority": false,
    "publication_ineligible_evidence_may_support_authority_where_required": false,
    "missing_is_neutral": false,
    "missing_is_negative": false,
    "missing_is_positive": false,
    "missing_is_zero": false
  },

  "non_shortcut_rules": {
    "score_label_alone_establishes_authority": false,
    "normalized_score_alone_establishes_authority": false,
    "risk_level_alone_establishes_authority": false,
    "confidence_status_alone_establishes_authority": false,
    "signal_score_alone_establishes_authority": false,
    "single_evidence_domain_alone_establishes_authority": false
  },

  "threshold_governance": {
    "defines_new_numeric_thresholds": false,
    "duplicates_upstream_numeric_thresholds": false,
    "redefines_score_thresholds": false,
    "redefines_signal_thresholds": false,
    "redefines_confidence_thresholds": false,
    "redefines_risk_thresholds": false,
    "redefines_publication_source_tiers": false
  },

  "restriction_precedence": {
    "insufficient_evidence_blocks_authority": true,
    "unresolved_material_conflict_blocks_authority": true,
    "material_risk_restriction_blocks_authority": true,
    "required_confirmation_missing_blocks_authority": true,
    "publication_ineligibility_where_required_blocks_authority": true,
    "positive_authority_may_override_restriction": false
  },

  "fallback_semantics": {
    "authority_not_established_state": "WATCH",
    "watch_requires_usable_evidence": true,
    "watch_requires_no_higher_priority_restriction": true,
    "missing_evidence_does_not_fallback_to_watch": true
  },

  "information_class": {
    "input_observations": "FACT",
    "upstream_analytical_outputs": "MODEL",
    "directional_thesis": "INFERENCE",
    "actionable_authority_assessment": "INFERENCE",
    "decision_state": "DECISION",
    "inference_may_be_presented_as_fact": false,
    "decision_may_be_presented_as_fact": false
  },

  "phase_boundary": {
    "implements_evidence_gate": false,
    "implements_conflict_resolver": false,
    "implements_decision_state_engine": false,
    "writes_decision_center": false,
    "modifies_generator": false,
    "modifies_schema_v3": false,
    "modifies_v2_1": false
  },

  "prohibited_behaviors": [
    "MODIFY_V2_1",
    "MODIFY_SCHEMA_V3_IN_D2D4B",
    "RECALCULATE_UPSTREAM_MODELS",
    "DUPLICATE_UPSTREAM_NUMERIC_THRESHOLDS",
    "TREAT_STRONG_BUY_AS_ACTIONABLE_AUTHORITY",
    "TREAT_BUY_AS_ACTIONABLE_AUTHORITY",
    "CREATE_AUTHORITY_FROM_SCORE_ALONE",
    "CREATE_AUTHORITY_FROM_RISK_LEVEL_ALONE",
    "CREATE_AUTHORITY_FROM_CONFIDENCE_ALONE",
    "CREATE_AUTHORITY_FROM_SIGNAL_SCORE_ALONE",
    "CREATE_AUTHORITY_FROM_SINGLE_EVIDENCE_DOMAIN",
    "CREATE_AUTHORITY_FROM_BLOCKED_EVIDENCE",
    "CREATE_AUTHORITY_FROM_UNAVAILABLE_EVIDENCE",
    "CREATE_AUTHORITY_FROM_INVALID_PROVENANCE",
    "OVERRIDE_PUBLICATION_ELIGIBILITY",
    "OVERRIDE_MATERIAL_RISK_RESTRICTION",
    "DISCARD_MATERIAL_CONFLICT",
    "ASSUME_REQUIRED_CONFIRMATION_SATISFIED",
    "TREAT_MISSING_AS_NEUTRAL",
    "TREAT_MISSING_AS_WATCH",
    "TRANSLATE_ACTIONABLE_AUTHORITY_TO_BUY",
    "TRANSLATE_ACTIONABLE_AUTHORITY_TO_SELL",
    "EXECUTE_TRADE_FROM_ACTIONABLE_AUTHORITY",
    "WRITE_DECISION_CENTER_IN_D2D4B"
  ]
}
